{
  "expo": {
    "name": "Tableside",
    "slug": "tableside",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tableside",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
