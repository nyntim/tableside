{
  "name": "odyssey-ops",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@odyssey/dashboard",
    "dev:backend": "turbo run dev --filter=@odyssey/backend",
    "dev": "turbo run dev --parallel --filter=@odyssey/dashboard --filter=@odyssey/backend",
    "gen:contract": "turbo run gen:openapi --filter=@odyssey/backend && turbo run gen:client --filter=@odyssey/api-client",
    "gen:contract:check": "pnpm gen:contract && git diff --exit-code -- services/backend/openapi packages/api-client/src/generated",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @odyssey/db db:generate",
    "db:migrate": "pnpm --filter @odyssey/db db:migrate",
    "db:seed": "pnpm --filter @odyssey/db db:seed",
    "db:reset": "pnpm --filter @odyssey/db db:reset",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed && pnpm gen:contract"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3"
  }
}
