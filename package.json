{
  "name": "tableside",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@tableside/dashboard",
    "dev:backend": "turbo run dev --filter=@tableside/backend",
    "dev": "turbo run dev --parallel --filter=@tableside/dashboard --filter=@tableside/backend",
    "gen:contract": "turbo run gen:openapi --filter=@tableside/backend && turbo run gen:client --filter=@tableside/api-client",
    "gen:contract:check": "pnpm gen:contract && git diff --exit-code -- services/backend/openapi packages/api-client/src/generated",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tableside/db db:generate",
    "db:migrate": "pnpm --filter @tableside/db db:migrate",
    "db:seed": "pnpm --filter @tableside/db db:seed",
    "db:reset": "pnpm --filter @tableside/db db:reset",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed && pnpm gen:contract"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
